# Copy to .env (gitignored). Never commit real keys.

# --- Monad ---
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# --- Wallets (generate with `cast wallet new`; testnet only) ---
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=
BOT_MOMENTUM_PRIVATE_KEY=
BOT_MOMENTUM_ADDRESS=
BOT_FUNDING_PRIVATE_KEY=
BOT_FUNDING_ADDRESS=
BOT_COINFLIP_PRIVATE_KEY=
BOT_COINFLIP_ADDRESS=
BOT_CONTRARIAN_PRIVATE_KEY=
BOT_CONTRARIAN_ADDRESS=
CRE_BROADCASTER_PRIVATE_KEY=
CRE_BROADCASTER_ADDRESS=
TESTER_CURATOR_PRIVATE_KEY=
TESTER_CURATOR_ADDRESS=
TESTER_SUBSCRIBER_PRIVATE_KEY=
TESTER_SUBSCRIBER_ADDRESS=

# --- Chainlink CRE: run `cre login`, or set an API key (app.chain.link > Account Settings) ---
CRE_API_KEY=

# --- Envio: HyperSync token from envio.dev/app/api-tokens (HyperIndex reads ENVIO_API_TOKEN) ---
ENVIO_API_TOKEN=

# --- Nansen: API key from app.nansen.ai ---
NANSEN_API_KEY=

# --- Delivery store (Phase 3): Upstash Redis, or Vercel marketplace Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Aurora Intents (Phase 8, optional): Studio key for 1Click quotes ---
AURORA_API_KEY=
